{
  "name": "github_app_read_file",
  "description": "Read a text file from an allowed GitHub repository using GitHub App authentication. Auth is handled internally via a private key stored in Key Vault.",
  "readOnly": true,
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["org", "repo", "path"],
    "properties": {
      "org": {
        "type": "string",
        "description": "GitHub organization name."
      },
      "repo": {
        "type": "string",
        "description": "GitHub repository name."
      },
      "path": {
        "type": "string",
        "description": "Repository-relative file path to read."
      },
      "ref": {
        "type": "string",
        "description": "Branch, tag, or commit SHA. Defaults to the repository default branch if omitted."
      },
      "maxBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1048576,
        "description": "Optional per-call cap on bytes returned."
      },
      "failOnTruncate": {
        "type": "boolean",
        "default": false,
        "description": "If true, return an error instead of truncated content."
      },
      "includeMetadata": {
        "type": "boolean",
        "default": true,
        "description": "If true, include commit SHA, size, and content type in the response."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["org", "repo", "path", "ref", "content", "truncated"],
    "properties": {
      "org": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "ref": {
        "type": "string"
      },
      "commitSha": {
        "type": "string",
        "description": "Resolved commit SHA for the requested ref."
      },
      "sizeBytes": {
        "type": "integer"
      },
      "contentType": {
        "type": "string",
        "description": "Detected content type, for example text/plain."
      },
      "encoding": {
        "type": "string",
        "description": "Encoding used for returned content, usually utf-8."
      },
      "content": {
        "type": "string",
        "description": "Decoded file content."
      },
      "truncated": {
        "type": "boolean"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "errorSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "message"],
    "properties": {
      "code": {
        "type": "string",
        "enum": [
          "not_found",
          "access_denied",
          "org_not_allowed",
          "repo_not_allowed",
          "path_not_allowed",
          "ref_not_found",
          "binary_file_not_supported",
          "file_too_large",
          "installation_not_found",
          "keyvault_access_denied",
          "internal_error"
        ]
      },
      "message": {
        "type": "string"
      },
      "retryable": {
        "type": "boolean"
      }
    }
  },
  "runtimeConfigSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["appId", "keyVault", "allowedOrgs"],
    "properties": {
      "appId": {
        "type": "string",
        "description": "GitHub App ID."
      },
      "installationMode": {
        "type": "string",
        "enum": ["auto", "fixed"],
        "default": "auto",
        "description": "Auto resolves installation from org/repo. Fixed uses a configured installation ID."
      },
      "installationId": {
        "type": "string",
        "description": "Required when installationMode is fixed."
      },
      "keyVault": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vaultName", "secretName"],
        "properties": {
          "vaultName": {
            "type": "string"
          },
          "secretName": {
            "type": "string"
          },
          "secretVersion": {
            "type": "string"
          }
        }
      },
      "allowedOrgs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "allowedRepos": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional repo allowlist. Empty means all repos in allowedOrgs."
      },
      "allowedPathPrefixes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional safe path prefixes, for example src/, docs/, .github/workflows/."
      },
      "maxFileBytes": {
        "type": "integer",
        "default": 262144
      },
      "blockBinaryFiles": {
        "type": "boolean",
        "default": true
      },
      "redactSecretsInErrors": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
